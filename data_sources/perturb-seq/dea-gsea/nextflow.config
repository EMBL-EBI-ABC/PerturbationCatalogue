manifest {
    name = 'PerturbationCatalogue/perturb-seq-dea-gsea'
    description = 'Nextflow pipeline for DEA and preranked GSEA from filtered Perturb-seq H5AD files.'
    mainScript = 'main.nf'
    version = '1.0.0'
}

process.stageInMode = 'symlink'

profiles {
    standard {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '16 GB'
    }

    slurm {
        process {
            executor = 'slurm'
            errorStrategy = 'retry'
            maxRetries = 2

            withName: 'PREPARE_INPUTS' {
                cpus = 2
                memory = { 32.GB * task.attempt }
                time = '4h'
            }

            withName: 'ANALYZE_BATCH' {
                cpus = 4
                memory = { 64.GB * task.attempt }
                time = '18h'
            }

            withName: 'MERGE_RESULTS' {
                cpus = 2
                memory = { 32.GB * task.attempt }
                time = '4h'
            }
        }
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = "${baseDir}/dea_gsea.sif"
    }
}
