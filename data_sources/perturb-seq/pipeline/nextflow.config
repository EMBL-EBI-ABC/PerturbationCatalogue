manifest {
    name = 'PerturbationCatalogue/perturb-seq'
    description = 'SRA-to-results Perturb-seq workflow: counting, QC, guide calling, comparison, DEA and GSEA.'
    mainScript = 'main.nf'
    version = '2.0.0'
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    slurm {
        executor.queueSize = 0
        process {
            executor = 'slurm'
            errorStrategy = 'retry'
            maxRetries = 3

            withName: 'BUILD_INDEX_STANDARD|BUILD_INDEX_KITE' {
                cpus = 8
                memory = '32 GB'
                time = '24h'
            }

            withName: 'KB_COUNT_STANDARD|KB_COUNT_KITE' {
                cpus = 16
                memory = '32 GB'
                time = '48h'
                errorStrategy = 'terminate'
            }

            withName: 'MERGE_MODALITIES' {
                cpus = 4
                memory = { 32.GB * task.attempt }
                time = '24h'
            }

            withName: 'CONCATENATE_SAMPLES' {
                cpus = 8
                memory = { 64.GB * task.attempt }
                time = '24h'
            }

            withName: 'COMPRESS_FINAL_H5AD' {
                cpus = 2
                memory = '16 GB'
                time = '24h'
            }

            withName: 'QC_COMPARISON' {
                cpus = 4
                memory = { 128.GB * task.attempt }
                time = '12h'
            }

            withName: 'PREPARE_INPUTS|MERGE_RESULTS' {
                cpus = 2
                memory = { 32.GB * task.attempt }
                time = '4h'
            }

            withName: 'ANALYZE_BATCH' {
                cpus = 4
                memory = { 64.GB * task.attempt }
                time = '18h'
            }
        }
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.envWhitelist = 'PYTHONNOUSERSITE'
        process {
            container = "${baseDir}/kb_python.sif"
            withName: 'QC_COMPARISON|PREPARE_INPUTS|ANALYZE_BATCH|MERGE_RESULTS' {
                container = "${baseDir}/../dea-gsea/dea_gsea.sif"
            }
        }
    }
}
