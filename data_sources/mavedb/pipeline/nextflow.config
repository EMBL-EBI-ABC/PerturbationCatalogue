manifest {
    name = 'PerturbationCatalogue/mavedb'
    description = 'MaveDB workflow: ingestion, unified reference preparation, canonical processing and optional analyses.'
    mainScript = 'main.nf'
    version = '0.4.0'
    nextflowVersion = '>=24.10.0'
}

params {
    archive = null
    zenodo_url = 'https://zenodo.org/records/18511521/files/mavedb-dump.20260206153444.zip?download=1'
    archive_sha256 = null
    outdir = "${projectDir}/../output/nextflow"
    download_dir = null
    python = "${projectDir}/../../../.venv/bin/python"
    help = false
    taxonomy = null
    taxonomy_url = 'https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxcat.tar.gz'
    reference_sources_manifest = null
    references_cache_dir = null
    refresh_references = false
    coding_variants_url = null
    evidence_url = null
    credible_sets_url = null
    reference_download_executor = null
    ingest_only = false
    run_gmm = false
    processed_dir = null
    rerun = ''
    compatibility_tables = null // Legacy accepted flag; tables are generated by default.
    run_qc = false
    run_reports = false
    run_validation = false
    uniprot_residues = null
    default_uniprot_residues = "${projectDir}/../references/protvar/protvar_2025_01_residues.tsv"
    validation_clinvar = null
    validation_gwas = null
    validation_formats = ['png', 'pdf']
    validation_dpi = 150
    validation_no_plots = false
    gmm_profile = 'production'
    gmm_model = 'modes'
    gmm_variants_per_batch = 50000
    gmm_seed = null
    gmm_study_ids = []
    gmm_max_studies = null
    gmm_max_study_rows = null
    gmm_max_fit_rows = null
    gmm_chains = null
    gmm_parallel_chains = null
    gmm_iter_warmup = null
    gmm_iter_sampling = null
    gmm_memory_budget_mb = null
    gmm_max_parallel = 2
    gmm_scratch = false
    gmm_fail_on_study_error = false
    gmm_cache_dir = "${projectDir}/../tmp/gmm_stan_cache"
}

// Keep work and resume metadata together by launching from the same directory.
workDir = "${projectDir}/../tmp/nextflow/work"

process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    time = '12h'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: mavedb_processing {
        memory = '4 GB'
    }
    withLabel: reference_preparation {
        cpus = 2
        memory = '8 GB'
    }
    withLabel: reference_package {
        cpus = 1
        memory = '2 GB'
    }
    withLabel: gmm_fit {
        cpus = { params.gmm_parallel_chains ?: (params.gmm_profile == 'smoke' ? 1 : 4) }
        memory = { ((params.gmm_memory_budget_mb ?: (params.gmm_profile == 'smoke' ? 2048 : 16384)).toInteger() + 1024).MB }
        maxForks = params.gmm_max_parallel
        scratch = params.gmm_scratch
        errorStrategy = 'finish'
    }
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            withLabel: ingest_download {
                executor = 'local'
            }
            withLabel: reference_download {
                executor = params.reference_download_executor ?: 'local'
            }
        }
    }
    local {
        process.executor = 'local'
        executor.queueSize = 1
    }
}
