Bootstrap: docker
From: python:3.10-slim

%labels
    Maintainer PerturbationCatalogue
    Version 1.2.0
    Description Single Singularity image for the complete Perturb-seq pipeline.

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libgomp1 \
        libhdf5-dev \
        hdf5-tools \
        procps \
        samtools \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev

    curl -fL https://ftp-trace.ncbi.nlm.nih.gov/sra/sdk/3.4.1/sratoolkit.3.4.1-ubuntu64.tar.gz -o /tmp/sra.tar.gz
    tar -xzf /tmp/sra.tar.gz -C /opt
    rm /tmp/sra.tar.gz

    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        kb-python==0.30.2 \
        "anndata>=0.10,<0.12" \
        "scanpy>=1.10,<1.12" \
        "gseapy>=1.1,<1.3" \
        "pandas>=2.2,<3" \
        "numpy>=1.26,<3" \
        "scipy>=1.11,<2" \
        "h5py>=3.10,<4" \
        "pyarrow>=15,<22" \
        "statsmodels>=0.14,<1" \
        matplotlib \
        seaborn \
        openpyxl \
        "PyYAML>=6,<7"

    curl -fL https://github.com/ArcInstitute/cyto/releases/download/cyto-0.4.5/cyto-linux-x86_64 -o /tmp/cyto
    echo "56adb8702753fb988bca0d8939ec49deba06b5f33bd4173469b3b67a7a8d87b3  /tmp/cyto" | sha256sum -c -
    install -m 0755 /tmp/cyto /usr/local/bin/cyto
    curl -fL https://github.com/ArcInstitute/cyto/releases/download/cyto-0.4.5/cyto-resources.tar.gz -o /tmp/cyto-resources.tar.gz
    echo "f004e5eb5e2020c3d5c894f3c19838bbfbdad548be722f875c6a3afceace13ca  /tmp/cyto-resources.tar.gz" | sha256sum -c -
    mkdir -p /opt/cyto
    tar -xzf /tmp/cyto-resources.tar.gz -C /opt/cyto
    rm /tmp/cyto /tmp/cyto-resources.tar.gz

    # Clean up to reduce image size
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/sratoolkit.3.4.1-ubuntu64/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec kb "$@"

%test
    cyto --version | grep -F "0.4.5"
    test -s /opt/cyto/resources/737K-fixed-rna-profiling.txt.gz
    test -s /opt/cyto/resources/probe-barcodes-fixed-rna-profiling-rna.txt
    test -s /opt/cyto/resources/probe-barcodes-fixed-rna-profiling-crispr.txt

%help
    This container provides every runtime dependency for the complete
    Perturb-seq pipeline, including kb-python, QC/comparison and DEA/GSEA.
    Build with: singularity build --fakeroot perturb_seq.sif Singularity.def
