Bootstrap: docker
From: python:3.11-slim

%labels
    Maintainer PerturbationCatalogue
    Version 1.0.0
    Description Singularity image for Perturb-seq DEA/GSEA with Scanpy and GSEApy.

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libgomp1 \
        libhdf5-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev

    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        "anndata>=0.10,<0.12" \
        "scanpy>=1.10,<1.12" \
        "gseapy>=1.1,<1.3" \
        "pandas>=2.2,<3" \
        "numpy>=1.26,<3" \
        "scipy>=1.11,<2" \
        "h5py>=3.10,<4" \
        "pyarrow>=15,<22" \
        "statsmodels>=0.14,<1" \
        "PyYAML>=6,<7"

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1
    export MKL_NUM_THREADS=1
    export NUMEXPR_NUM_THREADS=1
    export PYTHONNOUSERSITE=1

%runscript
    exec python "$@"

%help
    Build with:
      singularity build --force dea_gsea.sif Singularity.def
