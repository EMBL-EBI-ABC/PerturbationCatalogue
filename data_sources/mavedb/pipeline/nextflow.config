manifest {
    name = 'PerturbationCatalogue/mavedb'
    description = 'MaveDB workflow: ingestion, canonical processing and planned GMM fitting.'
    mainScript = 'main.nf'
    version = '0.3.0'
    nextflowVersion = '>=24.10.0'
}

params {
    archive = null
    zenodo_url = 'https://zenodo.org/records/18511521/files/mavedb-dump.20260206153444.zip?download=1'
    archive_sha256 = null
    outdir = "${projectDir}/../output/nextflow"
    download_dir = null
    python = "${projectDir}/../../../.venv/bin/python"
    help = false
    taxonomy = null
    taxonomy_url = 'https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxcat.tar.gz'
    ingest_only = false
    run_gmm = false
    processed_dir = null
    gmm_profile = 'production'
    gmm_model = 'modes'
    gmm_variants_per_batch = 50000
    gmm_seed = null
    gmm_study_ids = []
    gmm_max_studies = null
    gmm_max_study_rows = null
    gmm_max_fit_rows = null
    gmm_chains = null
    gmm_parallel_chains = null
    gmm_iter_warmup = null
    gmm_iter_sampling = null
    gmm_memory_budget_mb = null
    gmm_max_parallel = 2
    gmm_scratch = false
    gmm_cache_dir = "${projectDir}/../tmp/gmm_stan_cache"
}

// Keep work and resume metadata together by launching from the same directory.
workDir = "${projectDir}/../tmp/nextflow/work"

process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    time = '12h'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: mavedb_processing {
        memory = '4 GB'
    }
    withLabel: gmm_fit {
        cpus = { params.gmm_parallel_chains ?: (params.gmm_profile == 'smoke' ? 1 : 4) }
        memory = { ((params.gmm_memory_budget_mb ?: (params.gmm_profile == 'smoke' ? 2048 : 16384)).toInteger() + 1024).MB }
        maxForks = params.gmm_max_parallel
        scratch = params.gmm_scratch
    }
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            withLabel: 'ingest_download|reference_download' {
                executor = 'local'
            }
        }
    }
    local {
        process.executor = 'local'
        executor.queueSize = 1
    }
}
