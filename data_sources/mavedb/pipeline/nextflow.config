manifest {
    name = 'PerturbationCatalogue/mavedb'
    description = 'MaveDB workflow: raw ingestion and canonical metadata/score processing.'
    mainScript = 'main.nf'
    version = '0.2.0'
    nextflowVersion = '>=24.10.0'
}

params {
    archive = null
    zenodo_url = 'https://zenodo.org/records/18511521/files/mavedb-dump.20260206153444.zip?download=1'
    archive_sha256 = null
    outdir = "${projectDir}/../output/nextflow"
    download_dir = null
    python = "${projectDir}/../../../.venv/bin/python"
    help = false
    taxonomy = null
    taxonomy_url = 'https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxcat.tar.gz'
    ingest_only = false
}

// Keep work and resume metadata together by launching from the same directory.
workDir = "${projectDir}/../tmp/nextflow/work"

process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    time = '12h'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: mavedb_processing {
        memory = '4 GB'
    }
}

profiles {
    local {
        process.executor = 'local'
        executor.queueSize = 1
    }
}
