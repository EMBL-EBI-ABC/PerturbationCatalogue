// EBI Codon Slurm configuration for MaveDB Nextflow pipeline

params {
    python           = '/hps/nobackup/mfreeberg/aleks/PerturbationCatalogue/.venv/bin/python'
    outdir           = '/hps/nobackup/mfreeberg/aleks/PerturbationCatalogue/data_sources/mavedb/output/nextflow'
    download_dir     = '/hps/nobackup/mfreeberg/aleks/PerturbationCatalogue/data_sources/mavedb/output/nextflow/downloads'
    gmm_cache_dir    = '/hps/nobackup/mfreeberg/aleks/PerturbationCatalogue/data_sources/mavedb/tmp/gmm_stan_cache'
    gmm_scratch      = false
    gmm_max_parallel = 20
}

workDir = '/hps/nobackup/mfreeberg/aleks/PerturbationCatalogue/data_sources/mavedb/tmp/nextflow/work'

env {
    CMDSTAN = '/homes/zakirov/.cmdstan/cmdstan-2.40.0'
}

executor {
    name            = 'slurm'
    queueSize       = 30
    submitRateLimit = '5 sec'
}

process {
    queue          = 'standard'
    clusterOptions = '--account=fergal --qos=normal'

    cpus   = 1
    memory = '4 GB'
    time   = '6h'

    withLabel: mavedb_processing {
        cpus   = 1
        memory = '8 GB'
        time   = '6h'
    }

    withLabel: gmm_fit {
        maxForks = params.gmm_max_parallel
        time     = '24h'
    }
}
