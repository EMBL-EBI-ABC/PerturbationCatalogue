Bootstrap: docker
From: python:3.10-slim

%labels
    Maintainer PerturbationCatalogue
    Version 1.2.0
    Description Single Singularity image for the complete Perturb-seq pipeline.

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        libgomp1 \
        libhdf5-dev \
        hdf5-tools \
        procps \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev

    curl -fL https://ftp-trace.ncbi.nlm.nih.gov/sra/sdk/3.4.1/sratoolkit.3.4.1-ubuntu64.tar.gz -o /tmp/sra.tar.gz
    tar -xzf /tmp/sra.tar.gz -C /opt
    rm /tmp/sra.tar.gz

    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir \
        kb-python==0.30.2 \
        "anndata>=0.10,<0.12" \
        "scanpy>=1.10,<1.12" \
        "gseapy>=1.1,<1.3" \
        "pandas>=2.2,<3" \
        "numpy>=1.26,<3" \
        "scipy>=1.11,<2" \
        "h5py>=3.10,<4" \
        "pyarrow>=15,<22" \
        "statsmodels>=0.14,<1" \
        matplotlib \
        seaborn \
        openpyxl \
        "PyYAML>=6,<7"

    # Clean up to reduce image size
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/sratoolkit.3.4.1-ubuntu64/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec kb "$@"

%help
    This container provides every runtime dependency for the complete
    Perturb-seq pipeline, including kb-python, QC/comparison and DEA/GSEA.
    Build with: singularity build --fakeroot perturb_seq.sif Singularity.def
