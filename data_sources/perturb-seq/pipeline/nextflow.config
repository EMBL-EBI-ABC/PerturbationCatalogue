manifest {
    name = 'PerturbationCatalogue/perturb-seq'
    description = 'Nextflow pipeline for processing raw Perturb-seq FASTQ datasets into H5AD files using Kallisto and Bustools (kb-python).'
    mainScript = 'main.nf'
    version = '1.0.0'
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '8 GB'
    }

    slurm {
        process {
            executor = 'slurm'
            queue = 'batch' // update with the actual Slurm partition if necessary
            cpus = 8
            memory = '32 GB'
            time = '4h'
            errorStrategy = 'retry'
            maxRetries = 3

            withName: 'BUILD_INDEX_STANDARD|BUILD_INDEX_KITE' {
                cpus = 4
                memory = '16 GB'
                time = '2h'
            }

            withName: 'KB_COUNT' {
                cpus = 16
                memory = '64 GB'
                time = '12h'
            }
        }
    }
}

// Ensure the pipeline can use Conda or Singularity for dependencies
process {
    conda = 'kb-python' // assumes you have kb-python available in Conda/Mamba
}
